# Uploads: serve images only — never execute scripts from here
# (no 'Options' directive — InfinityFree does not allow it in .htaccess)
<FilesMatch "\.(php|php\d|phtml|pl|py|cgi|sh|shtml)$">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</FilesMatch>
